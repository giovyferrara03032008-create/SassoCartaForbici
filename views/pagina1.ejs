<!DOCTYPE html>
<html lang="<%= lingua %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.titolo %></title>
    <link rel="stylesheet" href="style1.css">
    <style>
        .switch-lingua { text-align: right; padding: 10px; }
        .switch-lingua button { background: #eee; border: 1px solid #ccc; cursor: pointer; padding: 5px 10px; margin-left: 5px; font-weight: bold;}
        .switch-lingua button.attivo { background: #333; color: #fff; }
    </style>
</head>
<body>
    <div class="switch-lingua">
        <form action="/cambia-lingua" method="POST" style="display:inline;">
            <input type="hidden" name="lingua" value="it">
            <button type="submit" class="<%= lingua === 'it' ? 'attivo' : '' %>">IT</button>
        </form>
        <form action="/cambia-lingua" method="POST" style="display:inline;">
            <input type="hidden" name="lingua" value="en">
            <button type="submit" class="<%= lingua === 'en' ? 'attivo' : '' %>">EN</button>
        </form>
    </div>

    <div class="contenitore">
        <div class="intestazione">
            <div class="titolo-gioco"><%= t.titolo %></div>
        </div>

        <div class="introduzione">
            <div class="testo-introduzione"><%= t.scopo %></div>
        </div>

        <div class="regole">
            <div class="regola"><%= t.regola1 %></div>
            <div class="regola"><%= t.regola2 %></div>
            <div class="regola"><%= t.regola3 %></div>
            <div class="regola"><%= t.regola4 %></div>
        </div>

        <div class="bottone-gioca-di-nuovo">
            <form action="/inizia" method="POST" class="form-gioco">
                <input type="text" name="nome" placeholder="<%= t.placeholderNome %>" required class="input-giocatore">
                <button type="submit" class="bottone-gioca"><%= t.btnGioca %></button>
            </form>
        </div>
        <div class="contenitore">
            <div class="info-autore">
                <div class="titolo-autore"><%= t.autore %></div>
                 <h2 class="nome-autore">Ferrara Giovanni</h2>
             </div>
        </div>
    </div>

   <audio id="introAudio" src="/intro.mp3" preload="auto" loop></audio>

<script>
const introAudio = document.getElementById('introAudio');
let audioPlayed = false;

function playAudio() {
    if (audioPlayed) return;
    introAudio.play().catch(()=>{});
    audioPlayed = true;
}

document.addEventListener('click', playAudio, { once: true });
document.addEventListener('touchstart', playAudio, { once: true });
window.addEventListener('beforeunload', () => {
    introAudio.pause();
    introAudio.currentTime = 0;
});
document.addEventListener('visibilitychange', () => {
    if (document.hidden) introAudio.pause();
});
</script>
</body>
</html>