<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sasso, Carta, Forbici</title>
    <link rel="stylesheet" href="/style2.css">
</head>
<body>

<div class="barra-statistiche">
    <div class="stat">Partita: <%= numeroPartita %></div>
    <div class="stat">Punti <%= nomeGiocatore %>: <%= puntiGiocatore %></div>
    <div class="stat">Punti Utente online: <%= puntiMacchina %></div>
</div>

<div class="schermo">
    <div class="lato utente">
        <div class="titolo">Scegli il tuo segno <%= nomeGiocatore %></div>
        <div class="scelte">
            <% const opzioni = ['sasso', 'carta', 'forbici']; %>
            <% opzioni.forEach(scelta => { %>
            <div class="box-scelta">
                <form class="form-scelta" action="/gioco" method="post">
                    <input type="hidden" name="scelta" value="<%= scelta %>">
                    <button class="btn-scelta" type="button"
                         onclick="scegliEParla(this.form, '<%= scelta %>')">
                    <img src="/<%= scelta %>.png" class="img-scelta">
                    </button>
                </form>
                <div class="nome"><%= scelta.charAt(0).toUpperCase() + scelta.slice(1) %></div>
            </div>
            <% }) %>
        </div>
    </div>

    <div class="lato macchina">
        <div class="titolo">Scelta utente online</div>
        <div class="scelte">
            <% opzioni.forEach(scelta => { %>
            <div class="box-scelta">
                <img src="/<%= scelta %>.png"
                    class="img-scelta macchina-img <%= gioco && gioco.computer && gioco.computer.scelta === scelta ? 'scelta-attiva' : '' %>">
                <div class="nome"><%= scelta.charAt(0).toUpperCase() + scelta.slice(1) %></div>
            </div>
            <% }) %>
        </div>
    </div>
</div>

<% if (gioco && gioco.giocatore && gioco.computer) { %>
<div class="pannello-risultati">
    <div class="righe-laterali">
        <div class="riga-gio">Hai scelto: <%= gioco.giocatore.scelta %></div>
        <div class="riga-mac">l'utente online ha scelto: <%= gioco.computer.scelta %></div>
    </div>

    <% 
        let risultato = "Hai perso!";
        let classeRisultato = "esito-perso";

        if (gioco.giocatore.valore === gioco.computer.valore) {
            risultato = "Hai pareggiato!";
            classeRisultato = "esito-pareggio";
        } else if (
            (gioco.giocatore.valore === 1 && gioco.computer.valore === 3) ||
            (gioco.giocatore.valore === 2 && gioco.computer.valore === 1) ||
            (gioco.giocatore.valore === 3 && gioco.computer.valore === 2)
        ) {
            risultato = "Hai vinto!";
            classeRisultato = "esito-vinto";
        }
    %>
    <div class="esito-final <%= classeRisultato %>"><%= risultato %></div>
</div>
<% } %>

<script>
/* 1) GESTIONE CLICK INIZIALE */
function scegliEParla(form, sceltaGiocatore) {
    // Salviamo la scelta per sapere che dobbiamo parlare al ricaricamento
    sessionStorage.setItem("eseguiTTS", "true");
    form.submit();
}

/* 2) LOGICA TTS AL REFRESH */
window.addEventListener("DOMContentLoaded", () => {
    if (sessionStorage.getItem("eseguiTTS") !== "true") return;

    const rigaGioElem = document.querySelector('.riga-gio');
    const rigaMacElem = document.querySelector('.riga-mac');
    const esitoElem = document.querySelector('.esito-final');

    if (!rigaGioElem) return;

    // Costruzione testo napoletano
    const segniNap = { 'sasso': "'o sasso", 'carta': "'a carta", 'forbici': "'e forbice" };
    let miaSceltaNap = "";
    const testoUtente = rigaGioElem.innerText.toLowerCase();
    
    if (testoUtente.includes("sasso")) miaSceltaNap = segniNap['sasso'];
    else if (testoUtente.includes("carta")) miaSceltaNap = segniNap['carta'];
    else if (testoUtente.includes("forbici")) miaSceltaNap = segniNap['forbici'];

    let discorso = "Guagliò, tu ha' scigliuto " + miaSceltaNap + ". ";
    
    if (rigaMacElem) {
        const testoMacchina = rigaMacElem.innerText.toLowerCase();
        let sceltaMacNap = "";
        if (testoMacchina.includes("sasso")) sceltaMacNap = segniNap['sasso'];
        else if (testoMacchina.includes("carta")) sceltaMacNap = segniNap['carta'];
        else if (testoMacchina.includes("forbici")) sceltaMacNap = segniNap['forbici'];
        if (sceltaMacNap) discorso += "Chillu là ha tirato " + sceltaMacNap + ". ";
    }

    if (esitoElem) {
        let testoEsito = esitoElem.innerText.toLowerCase();
        if (testoEsito.includes("vinto")) discorso += "Uè uè! Hai vinciuto tu! Si' troppo fort!";
        else if (testoEsito.includes("perso")) discorso += "uaa! Hai perzo... chille è cchiù furb' 'e te!";
        else discorso += "Simm' pari, facimm' n'ata mossa.";
    }

    // Funzione core per parlare
    function avviaAudio() {
        // Se sta già parlando, non sovrapporre
        if (speechSynthesis.speaking) return;

        speechSynthesis.cancel(); // Pulisce code precedenti
        const utterance = new SpeechSynthesisUtterance(discorso);
        utterance.lang = "it-IT";
        utterance.rate = 0.9; // Leggermente più lento per chiarezza
        utterance.pitch = 1.1;

        // Cerchiamo la voce migliore (Google Italian è la top su Android)
        const voci = speechSynthesis.getVoices();
        const voceMigliore = voci.find(v => v.name.includes("Google") && v.lang.includes("it")) || 
                             voci.find(v => v.lang.includes("it"));
        
        if (voceMigliore) utterance.voice = voceMigliore;

        speechSynthesis.speak(utterance);
        
        // Una volta parlato, puliamo la sessione
        sessionStorage.removeItem("eseguiTTS");
    }

    // TENTATIVO 1: Automatico (spesso bloccato dai browser)
    if (speechSynthesis.onvoiceschanged !== undefined) {
        speechSynthesis.onvoiceschanged = avviaAudio;
    }
    setTimeout(avviaAudio, 300);

    // TENTATIVO 2: Sblocco al primo tocco (Fondamentale per Smartphone)
    // Se il browser ha bloccato l'audio automatico, appena l'utente tocca 
    // lo schermo per vedere il risultato, la voce partirà.
    document.body.addEventListener('touchstart', avviaAudio, { once: true });
    document.body.addEventListener('click', avviaAudio, { once: true });
});

/* 3) STOP SE CHIUDI */
window.addEventListener("beforeunload", () => speechSynthesis.cancel());
</script>

</body>
</html>