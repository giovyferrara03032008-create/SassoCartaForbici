<!DOCTYPE html>
<html lang="<%= lingua %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t.arrivederci %></title>
    <link rel="stylesheet" href="/style3.css">
</head>
<body>

    <audio id="audioFinale" src="/<%= audioFile %>" preload="auto"></audio>

    <div class="contenitore-fine">
        <div class="stat"><%= t.guerriero %> <%= nomeGiocatore %>: <%= vittoriaGiocatore %></div>
        <div class="stat"><%= t.nemico %>: <%= vittoriaMacchina %></div>

        <div class="messaggio">
            <% if (puntiGiocatore === 3) { %>
                <p><%= t.complimenti.replace('%nome%', nomeGiocatore) %></p>
                <img src="/vittoria.png" width="200">
            <% } else { %>
                <p><%= t.dispiace.replace('%nome%', nomeGiocatore) %></p>
                <img src="/perdita.png">
            <% } %>
        </div>

        <div class="saluto"><%= t.arrivederci %></div>

        <div class="bottone-gioca-di-nuovo">
            <form action="/pagina2" method="get">
                <button type="submit" class="bottone" onclick="stoppaTutto()">
                    <%= t.btnRound %>
                </button>
            </form>
        </div>

        <div class="bottone-gioca-di-nuovo">
            <form action="/" method="get">
                <button type="submit" class="bottone" onclick="stoppaTutto()">
                    <%= t.btnHome %>
                </button>
            </form>
        </div>
    </div>

    <script>
    const synth = window.speechSynthesis;
    const audioSottofondo = document.getElementById("audioFinale");
    const linguaAttuale = "<%= lingua %>";
    const langCode = linguaAttuale === "it" ? "it-IT" : "en-US";

    function attivaTutto() {
        if (audioSottofondo) {
            audioSottofondo.volume = 0.3;
            audioSottofondo.play().catch(e => console.log("Audio MP3 bloccato"));
        }

        synth.cancel();
        const u = new SpeechSynthesisUtterance(window.discorsoGlobale);
        u.lang = langCode;
        u.rate = 1.0;
        
        const voci = synth.getVoices();
        const voceMigliore = voci.find(v => v.lang.includes(langCode) && v.name.includes("Google")) ||
                             voci.find(v => v.lang.includes(langCode));
        
        if (voceMigliore) u.voice = voceMigliore;
        synth.speak(u);
    }

    function stoppaTutto() {
        document.body.removeEventListener('touchstart', attivaTutto);
        document.body.removeEventListener('click', attivaTutto);
        synth.cancel();
        if (audioSottofondo) {
            audioSottofondo.pause();
            audioSottofondo.currentTime = 0;
        }
    }

    window.addEventListener("DOMContentLoaded", () => {
        const messaggioElem = document.querySelector('.messaggio p');
        if (!messaggioElem) return;

        const pG = parseInt("<%= puntiGiocatore %>");
        window.discorsoGlobale = "";

        if (linguaAttuale === "it") {
            // Audio Napoletano/Italiano
            if (pG === 3) {
                window.discorsoGlobale = "Uè uè, facimme festa! Complimenti <%= nomeGiocatore %>, ha' vinciuto tu e ha' fatto tre punte! ";
            } else {
                window.discorsoGlobale = "Uè uè, <%= nomeGiocatore %>... chillu là ha fatto tre punte primma 'e te. Tu ha' perzo! Ma nun te preoccupà, riprova!";
            }
            window.discorsoGlobale += " Arrivederci e statte bbuono!";
        } else {
            // Audio Inglese
            if (pG === 3) {
                window.discorsoGlobale = "Congratulations <%= nomeGiocatore %>, you won the match by reaching three points! Well done!";
            } else {
                window.discorsoGlobale = "Oh no, <%= nomeGiocatore %>, your opponent reached three points first. You lost this time, but don't give up, try again!";
            }
            window.discorsoGlobale += " Goodbye!";
        }

        setTimeout(() => {
            if (!synth.speaking) attivaTutto();
        }, 500);

        document.body.addEventListener('touchstart', attivaTutto, { once: true });
        document.body.addEventListener('click', attivaTutto, { once: true });
        window.addEventListener("pagehide", stoppaTutto);
    });
    </script>
</body>
</html>