<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fine Partita</title>
    <link rel="stylesheet" href="/style3.css">
</head>

<body>

    <audio id="audioFinale" src="/<%= audioFile %>" preload="auto"></audio>

    <div class="contenitore-fine">
        <div class="stat">Vittorie <%= nomeGiocatore %>: <%= vittoriaGiocatore %></div>
        <div class="stat">Vittorie utenti online: <%= vittoriaMacchina %></div>

        <div class="messaggio">
            <% if (puntiGiocatore === 3) { %>
                <p>Complimenti <%= nomeGiocatore %>! Hai raggiunto per primo 3 punti!!</p>
                <img src="/vittoria.png" width="200">
            <% } else { %>
                <p>Mi dispiace <%= nomeGiocatore %>, l'utente online ha raggiunto per prima 3 punti... Riprova!</p>
                <img src="/perdita.png">
            <% } %>
        </div>

        <div class="saluto">Arrivederci</div>

        <div class="bottone-gioca-di-nuovo">
            <form action="/pagina2" method="get">
                <button type="submit" class="bottone">
                    Clicca per giocare un altro Round online
                </button>
            </form>
        </div>

        <div class="bottone-gioca-di-nuovo">
            <form action="/" method="get">
                <button type="submit" class="bottone">
                    Clicca Qui per tornare alla Home
                </button>
            </form>
        </div>
    </div>

    <script>
    window.addEventListener("DOMContentLoaded", () => {
        const audioSottofondo = document.getElementById("audioFinale");
        const messaggioElem = document.querySelector('.messaggio p');
        if (!messaggioElem) return;

        const testoOriginale = messaggioElem.innerText;
        let discorso = "";

        // Traduzione Napoletana
        if (testoOriginale.includes("Complimenti")) {
            discorso = "Uè uè, facimme festa! Complimenti <%= nomeGiocatore %>, ha' vinciuto tu e ha' fatto tre punte! ";
        } else {
            discorso = "Uè uè, <%= nomeGiocatore %>... chillu là ha fatto tre punte primma 'e te. Tu ha' perzo! Ma nun te preoccupà, riprova!";
        }
        discorso += " Arrivederci e statte bbuono!";

        function attivaTutto() {
            // 1. Prova a far partire l'audio MP3
            if (audioSottofondo) {
                audioSottofondo.volume = 0.3; // Volume basso per non coprire la voce
                audioSottofondo.play().catch(e => console.log("Audio MP3 bloccato"));
            }

            // 2. Prova a far partire la voce
            speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(discorso);
            u.lang = "it-IT";
            u.rate = 1.0;
            u.pitch = 1.1;

            const voci = speechSynthesis.getVoices();
            const voceMigliore = voci.find(v => v.lang.includes("it-IT") && v.name.includes("Google")) || 
                                 voci.find(v => v.lang.includes("it-IT"));
            
            if (voceMigliore) u.voice = voceMigliore;
            
            speechSynthesis.speak(u);
        }

        // TENTATIVO AUTOMATICO (PC)
        setTimeout(attivaTutto, 500);
        if (speechSynthesis.onvoiceschanged !== undefined) {
            speechSynthesis.onvoiceschanged = attivaTutto;
        }

        // SBLOCCO PER TELEFONO (GOOGLE CHROME / SAFARI)
        // Fondamentale: al primo tocco dell'utente parte tutto
        document.body.addEventListener('touchstart', attivaTutto, { once: true });
        document.body.addEventListener('click', attivaTutto, { once: true });
    });

    window.addEventListener("beforeunload", () => speechSynthesis.cancel());
    </script>
</body>
</html>